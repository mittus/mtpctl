<!doctype html>
<!-- {{GENERATED}} -->
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>mtpctl</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232f6fed'/%3E%3Cpath d='M9 10l6 6-6 6M17 22h6' stroke='white' stroke-width='2.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
:root{--bg:#f3f5f9;--card:#fff;--text:#1c2330;--muted:#6b7485;--line:#d9dee7;--accent:#2f6fed;--accent-h:#2259c7;--err-bg:#fdecec;--err:#b42318}
@media (prefers-color-scheme:dark){:root{--bg:#0f131a;--card:#171c25;--text:#e6e9ef;--muted:#8a93a3;--line:#2a313d;--accent:#4b84f5;--accent-h:#3a71e0;--err-bg:#3a1c1c;--err:#f08b8b}}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;align-items:center;justify-content:center;padding:16px}
.box{width:100%;max-width:360px}
.logo{display:flex;align-items:center;gap:10px;justify-content:center;margin-bottom:22px;font-weight:600;font-size:18px}
.logo svg{width:32px;height:32px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:28px 24px;box-shadow:0 1px 3px rgba(0,0,0,.05)}
h1{font-size:19px;margin:0 0 4px}
.sub{color:var(--muted);margin:0 0 20px;font-size:14px}
label{display:block;font-size:13px;font-weight:500;margin:14px 0 6px}
input[type=text],input[type=password]{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--text);font:inherit}
input:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:transparent}
.row{display:flex;justify-content:space-between;align-items:center;margin:14px 0 18px;font-size:13px}
.row label{margin:0;font-weight:400;display:flex;gap:6px;align-items:center}
a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}
button{width:100%;padding:11px;border:0;border-radius:8px;background:var(--accent);color:#fff;font:inherit;font-weight:600;cursor:pointer}
#f button{margin-top:14px}
button:hover{background:var(--accent-h)}button[disabled]{opacity:.7;cursor:default}
.err{display:none;background:var(--err-bg);color:var(--err);border-radius:8px;padding:9px 12px;font-size:13px;margin-bottom:6px}
.err.on{display:block}
.foot{text-align:center;color:var(--muted);font-size:12px;margin-top:18px}
html.wait body{visibility:hidden}
</style>
<script>
// Вход уже был в этом браузере — не мигать формой, пока проверяется сессия (не дольше 1,5 с).
try{if(localStorage.getItem('mtp.s')){document.documentElement.className='wait';setTimeout(function(){document.documentElement.className='';},1500);}}catch(e){}
</script>
</head>
<body>
<div class="box">
  <div class="logo">
    <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#2f6fed"/><path d="M9 10l6 6-6 6M17 22h6" stroke="#fff" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    mtpctl
  </div>
  <div class="card">
    <div class="err" id="err" role="alert">Неверный пароль</div>
    <form id="f" method="post" action="login" autocomplete="off">
      <input type="password" id="p" name="p" placeholder="Пароль" aria-label="Пароль" autocomplete="current-password" required autofocus>
      <button type="submit" id="b">Войти</button>
    </form>
  </div>
  <div class="foot">© {{YEAR}} mtpctl</div>
</div>
<script>
(function(){
  var H={'X-Requested-With':'XMLHttpRequest'},T0;
  var f=document.getElementById('f'),e=document.getElementById('err'),b=document.getElementById('b'),p=document.getElementById('p');
  function flag(on){try{on?localStorage.setItem('mtp.s','1'):localStorage.removeItem('mtp.s');}catch(x){}}
  function reveal(){document.documentElement.className='';}
  function boot(){
    return fetch('api/app',{headers:H,credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;return r.text();}).then(function(html){
      var t=document.createElement('template');t.innerHTML=html;
      document.body.className='app';document.body.replaceChildren();
      Array.prototype.slice.call(t.content.childNodes).forEach(function(n){
        if(n.nodeName==='SCRIPT'){var s=document.createElement('script');s.textContent=n.textContent;document.body.appendChild(s);}
        else document.body.appendChild(n);});
      flag(true);reveal();});}
  fetch('api/session',{headers:H,credentials:'same-origin'}).then(function(r){if(r.ok)return boot();flag(false);reveal();})
    .catch(function(){reveal();});
  if(/[?&]error=1/.test(location.search)){e.classList.add('on');history.replaceState(null,'',location.pathname);}
  f.addEventListener('submit',function(ev){
    ev.preventDefault();T0=Date.now();e.textContent='Неверный пароль';e.classList.remove('on');b.disabled=true;b.textContent='Проверка…';
    fetch('api/login',{method:'POST',credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Content-Type':'application/json'},
      body:JSON.stringify({password:p.value,remember:true})})
    .then(function(r){if(!r.ok)throw 0;return boot();})
    .catch(function(){setTimeout(function(){b.disabled=false;b.textContent='Войти';p.value='';e.classList.add('on');p.focus();},Math.max(0,900-(Date.now()-T0)));});
  });
})();
</script>
</body>
</html>
