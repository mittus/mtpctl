# mtpctl: server {{ID}} — generated by mtpctl agent from telemt.toml.tmpl; do not edit (re-rendered on change).
# Клиентов ([access.*]) mtpctl добавляет через API; telemt дописывает их в этот файл сам.
# Вход: {{DOMAIN}} -> входной хост {{ENTRY_IP}} -> сюда :{{PORT}} с PROXY protocol.

[general]
use_middle_proxy = false
log_level = "normal"
data_path = "/var/lib/telemt/{{ID}}"
quota_state_path = "/var/lib/telemt/{{ID}}/telemt.limit.json"

[general.modes]
classic = false
secure = false
tls = true

[general.links]
show = []
public_host = "{{DOMAIN}}"
public_port = 443

[server]
port = {{PORT}}
proxy_protocol = true
proxy_protocol_trusted_cidrs = ["{{ENTRY_IP}}/32"]

[server.api]
enabled = true
listen = "127.0.0.1:{{API_PORT}}"
whitelist = ["127.0.0.1/32"]
auth_header = "Bearer {{TOKEN}}"

[[server.listeners]]
ip = "0.0.0.0"

[censorship]
tls_domain = "{{DOMAIN}}"
{{TLS_DOMAINS}}
unknown_sni_action = "mask"
mask = true
mask_host = "127.0.0.1"                  # общий бэкенд всех доменов-заглушек: страница входа + кабинет
mask_port = 8446
mask_proxy_protocol = 1
tls_emulation = true
mask_relay_max_bytes = 67108864
mask_relay_timeout_ms = 600000

{{EXCLUSIVE_MASK}}

[access.users]
"_reserve" = "{{RESERVE_KEY}}"           # служебный: у telemt должен быть хоть один пользователь; выключен

[access.user_enabled]
"_reserve" = false
